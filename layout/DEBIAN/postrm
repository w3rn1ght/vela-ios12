#!/bin/sh
# postrm: остановить демон и убрать маршруты, если он не успел этого сделать.
DAEMON_PLIST=/Library/LaunchDaemons/com.vela.daemon.plist

launchctl unload "$DAEMON_PLIST" 2>/dev/null || true

if [ -x /sbin/route ]; then
	for net in "0.0.0.0/1" "128.0.0.0/1" "::/1" "8000::/1"; do
		/sbin/route delete -net "$net" >/dev/null 2>&1 || true
	done
fi

# nodes.json — данные пользователя, а не файлы пакета: dpkg вызывает postrm и при
# обновлении ($1 = upgrade), и при обычном удалении. Стираем только при purge,
# иначе после каждого dpkg -i список серверов приходится вводить заново.
if [ "$1" = "purge" ]; then
	rm -rf /var/mobile/Library/Vela /var/mobile/Library/Logs/Vela
fi

if [ -x /usr/bin/uicache ]; then
	uicache -p /Applications/Vela.app 2>/dev/null || true
fi

exit 0
